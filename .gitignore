node_modules/
server.log
npm-debug.log*

# Runtime player data — the server recreates empty {}./[] files automatically
# on first boot, so real player profiles never get committed to the repo.
database/data/*.json

# Android build output. Both are generated by scripts/build-www.js and
# `npx cap add android` during CI, so they never need to be committed.
www/
android/
dist/
